#!/bin/zsh
set -euo pipefail

repo_root=${0:A:h:h}
contract="$repo_root/toolchain/render-capture-v1.json"

/usr/bin/python3 - "$contract" <<'PY'
import json
import pathlib
import platform
import plistlib
import re
import subprocess
import sys

path = pathlib.Path(sys.argv[1])
expected_keys = {
    "schema",
    "architecture",
    "minimum_swift_version",
    "minimum_sdk_version",
    "deployment_target",
    "swift_language_version",
    "upstream_base",
}
contract = json.loads(path.read_text(encoding="utf-8"))
if set(contract) != expected_keys:
    missing = sorted(expected_keys - set(contract))
    unknown = sorted(set(contract) - expected_keys)
    raise SystemExit(f"toolchain contract keys differ: missing={missing} unknown={unknown}")
if contract["schema"] != "swiftterm.render-capture-toolchain/v2":
    raise SystemExit(f"unsupported toolchain contract schema: {contract['schema']!r}")

def run(*args):
    return subprocess.check_output(args, text=True).strip()

def version(text):
    return tuple(int(part) for part in text.split("."))

failures = []
swiftc = run("/usr/bin/xcrun", "--find", "swiftc")
swift_output = run(swiftc, "--version").splitlines()[0]
swift_match = re.search(r"Apple Swift version (\d+(?:\.\d+)*)", swift_output)
if swift_match is None:
    failures.append(f"compiler: no Swift version in {swift_output!r}")
elif version(swift_match.group(1)) < version(contract["minimum_swift_version"]):
    failures.append(
        f"compiler: expected Swift {contract['minimum_swift_version']} or newer, "
        f"got {swift_output!r}"
    )

architecture = platform.machine()
if architecture != contract["architecture"]:
    failures.append(f"architecture: expected {contract['architecture']!r}, got {architecture!r}")

sdk_path = pathlib.Path(run("/usr/bin/xcrun", "--show-sdk-path"))
settings = sdk_path / "SDKSettings.plist"
if not settings.is_file():
    failures.append(f"SDK settings are absent: {settings}")
else:
    with settings.open("rb") as stream:
        sdk = plistlib.load(stream)
    sdk_version = str(sdk.get("Version", ""))
    if not re.fullmatch(r"\d+(?:\.\d+)*", sdk_version):
        failures.append(f"SDK version: unreadable {sdk_version!r} at {sdk_path}")
    elif version(sdk_version) < version(contract["minimum_sdk_version"]):
        failures.append(
            f"SDK version: expected {contract['minimum_sdk_version']} or newer, "
            f"got {sdk_version!r} at {sdk_path}"
        )

if failures:
    raise SystemExit(
        "unsupported terminal-render-capture toolchain:\n- "
        + "\n- ".join(failures)
        + "\nInstall Command Line Tools providing at least the Swift and macOS SDK "
        "versions named in toolchain/render-capture-v1.json."
    )

print("toolchain contract satisfied")
PY
